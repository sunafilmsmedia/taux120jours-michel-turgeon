# --- Externes (tous optionnels : l'app fonctionne en mode stub sans eux) ---

# Anthropic (Claude) — utilisé côté serveur pour :
#  1. générer la réponse IA personnalisée (src/lib/ai.ts)
#  2. aller chercher les taux hypothécaires actuels via l'outil de recherche
#     web de Claude, mis en cache 12h côté serveur (src/lib/rates.ts)
# Tant que la clé n'est pas branchée, les deux retombent sur un mode local
# (texte générique / pas de chiffre de taux affiché).
ANTHROPIC_API_KEY=
# Optionnel : modèle (défaut: claude-opus-5-5).
ANTHROPIC_MODEL=

# CRM (GoHighLevel) — webhook entrant qui reçoit le lead. Si vide,
# src/lib/crm.ts logue le payload côté serveur au lieu de l'envoyer (pour ne
# jamais polluer le CRM de production pendant le dev/les tests).
#
# Michel utilise déjà ce webhook en production sur refinancement-michel-
# turgeon.vercel.app (même courtier, même CRM) — coller la même valeur ici
# une fois ce projet validé, pour que les deux outils tombent dans le même
# pipeline de leads :
# https://services.leadconnectorhq.com/hooks/ubISf2pSe45JMIfTVedD/webhook-trigger/c1c22a50-b659-4110-940d-108bd22ab657
CRM_WEBHOOK_URL=
